    def test_mismatched_document_fingerprint(self):
        home = self.make_home()

        content = self.make_document(home).replace(
            home["review"]["reviewed_content_sha256"],
            "0" * 64,
        )

        self.assert_error(
            validate_review_record_content(
                home,
                content,
            ),
            "mismatched Reviewed Content SHA-256",
        )

    # Document path security

    def test_valid_document_path(self):
        home = self.make_home()

        expected = (
            self.approvals_directory
            / "BEEP-HOME-TEST"
            / "1.0.0"
            / "technical-reviews"
            / "BEEP-REV-TEST-001.md"
        )

        self.assertEqual(
            get_review_record_path(
                home,
                self.approvals_directory,
            ),
            expected,
        )

    def test_unsafe_home_identifier(self):
        home = self.make_home(
            home_id="../outside"
        )

        with self.assertRaises(ValueError):
            get_review_record_path(
                home,
                self.approvals_directory,
            )

    def test_unsafe_version(self):
        home = self.make_home(
            version="../outside"
        )

        with self.assertRaises(ValueError):
            get_review_record_path(
                home,
                self.approvals_directory,
            )

    def test_unsafe_review_identifier(self):
        home = self.make_home(
            record_id="../outside"
        )

        with self.assertRaises(ValueError):
            get_review_record_path(
                home,
                self.approvals_directory,
            )

    def test_document_symbolic_link_rejected(self):
        home = self.make_home()

        path = self.write_document(home)

        target = self.root / "outside.md"

        target.write_text(
            self.make_document(home),
            encoding="utf-8",
        )

        path.unlink()

        path.symlink_to(target)

        self.assert_error(
            self.validate_home(home),
            "cannot contain symbolic links",
        )

    def test_parent_symbolic_link_rejected(self):
        home = self.make_home()

        outside = self.root / "outside"

        outside.mkdir()

        linked_directory = (
            self.approvals_directory
            / home["test_home_id"]
        )

        linked_directory.symlink_to(
            outside,
            target_is_directory=True,
        )

        self.assert_error(
            self.validate_home(home),
            "cannot contain symbolic links",
        )

    # Individual record validation

    def test_completed_review_with_document(self):
        home = self.make_home()

        self.write_document(home)

        self.assertEqual(
            self.validate_home(home),
            [],
        )

    def test_completed_review_without_document(self):
        home = self.make_home()

        self.assert_error(
            self.validate_home(home),
            "Missing technical review document",
        )

    def test_approved_home_with_document(self):
        home = self.make_home(
            status="APPROVED"
        )

        self.write_document(home)

        self.assertEqual(
            self.validate_home(home),
            [],
        )

    def test_retired_home_without_document(self):
        home = self.make_home(
            status="RETIRED"
        )

        self.assert_error(
            self.validate_home(home),
            "Missing technical review document",
        )

    def test_changed_technical_content_rejected(self):
        home = self.make_home()

        self.write_document(home)

        home["bedrooms"] = 4

        self.assert_error(
            self.validate_home(home),
            "does not match the completed review",
        )

    def test_development_without_document(self):
        home = self.make_home(
            status="DEVELOPMENT"
        )

        for field in home["review"]:
            home["review"][field] = None

        home["review"]["review_status"] = (
            "NOT_STARTED"
        )

        self.assertEqual(
            self.validate_home(home),
            [],
        )

    def test_in_progress_without_document(self):
        home = self.make_home()

        home["review"]["review_status"] = (
            "IN_PROGRESS"
        )

        for field in (
            "review_date",
            "review_findings",
            "review_recommendation",
            "reviewed_content_sha256",
        ):
            home["review"][field] = None

        self.assertEqual(
            self.validate_home(home),
            [],
        )

    # Registry-wide validation

    def test_multiple_versions_require_own_documents(self):
        first = self.make_home(
            version="1.0.0",
            status="RETIRED",
        )

        second = self.make_home(
            version="1.0.1",
            record_id="BEEP-REV-TEST-002",
        )

        self.write_document(first)

        self.write_registry([
            first,
            second,
        ])

        self.assert_error(
            self.validate_registry(),
            "BEEP-HOME-TEST/1.0.1: "
            "Missing technical review document",
        )

        self.write_document(second)

        self.assertEqual(
            self.validate_registry(),
            [],
        )

    def test_registry_validation_preserves_input(self):
        home = self.make_home()

        original = copy.deepcopy(home)

        self.write_document(home)
        self.write_registry([home])

        original_bytes = (
            self.registry_path.read_bytes()
        )

        self.assertEqual(
            self.validate_registry(),
            [],
        )

        self.assertEqual(home, original)

        self.assertEqual(
            self.registry_path.read_bytes(),
            original_bytes,
        )


if __name__ == "__main__":
    unittest.main()
