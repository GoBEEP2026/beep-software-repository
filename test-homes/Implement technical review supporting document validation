import copy
import json
import tempfile
import unittest
from pathlib import Path

from validate_technical_review import (
    calculate_technical_fingerprint,
)

from validate_technical_review_records import (
    is_valid_record_value,
    extract_review_record_fields,
    validate_review_record_content,
    get_review_record_path,
    validate_technical_review_record,
    validate_technical_review_records,
)


class TestTechnicalReviewRecords(unittest.TestCase):

    def setUp(self):
        self.temp_directory = (
            tempfile.TemporaryDirectory()
        )

        self.addCleanup(
            self.temp_directory.cleanup
        )

        self.root = Path(
            self.temp_directory.name
        )

        self.approvals_directory = (
            self.root / "approvals"
        )

        self.approvals_directory.mkdir()

        self.registry_path = (
            self.root / "registry.json"
        )

    def make_home(
        self,
        status="UNDER_REVIEW",
        home_id="BEEP-HOME-TEST",
        version="1.0.0",
        record_id="BEEP-REV-TEST-001",
    ):
        home = {
            "test_home_id": home_id,
            "test_home_version": version,
            "status": status,
            "conditioned_floor_area_ft2": 2200,
            "conditioned_volume_ft3": 19800,
            "bedrooms": 3,
            "reference_files": [
                {
                    "filename": "test-home.xml",
                    "sha256": "a" * 64,
                }
            ],
            "review": {
                "reviewer": "Fictional Test Reviewer",
                "review_record": record_id,
                "review_status": "COMPLETED",
                "review_date": "2026-11-24",
                "review_findings":
                    "Fictional technical findings.",
                "review_recommendation":
                    "RECOMMEND_APPROVAL",
                "conflict_of_interest_disclosure":
                    "Fictional test disclosure.",
                "reviewed_content_sha256": None,
            },
        }

        home["review"][
            "reviewed_content_sha256"
        ] = calculate_technical_fingerprint(home)

        return home

    def make_document(self, home):
        review = home["review"]

        fields = {
            "Reference Home ID":
                home["test_home_id"],
            "Reference Home Version":
                home["test_home_version"],
            "Technical Review Record ID":
                review["review_record"],
            "Technical Reviewer":
                review["reviewer"],
            "Technical Review Date":
                review["review_date"],
            "Technical Review Status":
                review["review_status"],
            "Review Findings":
                review["review_findings"],
            "Review Recommendation":
                review["review_recommendation"],
            "Conflict-of-Interest Disclosure":
                review["conflict_of_interest_disclosure"],
            "Reviewed Content SHA-256":
                review["reviewed_content_sha256"],
            "Review Scope":
                "Fictional review of building geometry.",
            "Supporting Evidence":
                "Fictional supporting calculations.",
        }

        lines = [
            "# Fictional Technical Review Record",
            "",
        ]

        for field, value in fields.items():
            lines.append(
                f"{field}: {value}"
            )

        return "\n".join(lines) + "\n"

    def write_document(self, home, content=None):
        path = get_review_record_path(
            home,
            self.approvals_directory,
        )

        path.parent.mkdir(
            parents=True,
            exist_ok=True,
        )

        if content is None:
            content = self.make_document(home)

        path.write_text(
            content,
            encoding="utf-8",
        )

        return path

    def write_registry(self, homes):
        self.registry_path.write_text(
            json.dumps({
                "registry_version": "1.1.0",
                "registry_status": "DEVELOPMENT",
                "reference_homes": homes,
            }),
            encoding="utf-8",
        )

    def validate_home(self, home):
        return validate_technical_review_record(
            home,
            self.approvals_directory,
        )

    def validate_registry(self):
        return validate_technical_review_records(
            self.registry_path,
            self.approvals_directory,
        )

    def assert_error(self, errors, expected):
        self.assertTrue(
            any(
                expected in error
                for error in errors
            ),
            errors,
        )

    # Metadata value validation

    def test_valid_metadata_value(self):
        self.assertTrue(
            is_valid_record_value(
                "Fictional technical findings."
            )
        )

    def test_empty_metadata_value(self):
        self.assertFalse(
            is_valid_record_value("")
        )

    def test_whitespace_metadata_value(self):
        self.assertFalse(
            is_valid_record_value("   ")
        )

    def test_non_string_metadata_value(self):
        self.assertFalse(
            is_valid_record_value(None)
        )

    def test_multiline_metadata_value(self):
        self.assertFalse(
            is_valid_record_value(
                "First line\nSecond line"
            )
        )

    def test_recognized_placeholders(self):
        for value in (
            "TBD",
            "Pending",
            "TODO",
            "placeholder",
            "YYYY-MM-DD",
            "To Be Determined",
        ):
            with self.subTest(value=value):
                self.assertFalse(
                    is_valid_record_value(value)
                )

    def test_bracketed_placeholder(self):
        self.assertFalse(
            is_valid_record_value("[REQUIRED]")
        )

    # Document field extraction

    def test_all_required_fields_extracted(self):
        home = self.make_home()

        fields, errors = (
            extract_review_record_fields(
                self.make_document(home)
            )
        )

        self.assertEqual(errors, [])
        self.assertEqual(len(fields), 12)

    def test_missing_required_field(self):
        home = self.make_home()

        content = self.make_document(home)

        content = content.replace(
            "Review Scope: Fictional review "
            "of building geometry.\n",
            "",
        )

        _, errors = (
            extract_review_record_fields(content)
        )

        self.assert_error(
            errors,
            "Missing required field: Review Scope",
        )

    def test_duplicate_required_field(self):
        home = self.make_home()

        content = self.make_document(home)

        content += (
            "Technical Reviewer: "
            "Another Fictional Reviewer\n"
        )

        _, errors = (
            extract_review_record_fields(content)
        )

        self.assert_error(
            errors,
            "Duplicate required field: Technical Reviewer",
        )

    def test_case_insensitive_duplicate_field(self):
        home = self.make_home()

        content = self.make_document(home)

        content += (
            "technical reviewer: "
            "Fictional Test Reviewer\n"
        )

        _, errors = (
            extract_review_record_fields(content)
        )

        self.assert_error(
            errors,
            "Duplicate required field: Technical Reviewer",
        )

    def test_empty_required_field(self):
        home = self.make_home()

        content = self.make_document(home)

        content = content.replace(
            "Review Scope: Fictional review "
            "of building geometry.",
            "Review Scope:",
        )

        _, errors = (
            extract_review_record_fields(content)
        )

        self.assert_error(
            errors,
            "Invalid or placeholder value for Review Scope",
        )

    def test_placeholder_required_field(self):
        home = self.make_home()

        content = self.make_document(home)

        content = content.replace(
            "Supporting Evidence: "
            "Fictional supporting calculations.",
            "Supporting Evidence: [REQUIRED]",
        )

        _, errors = (
            extract_review_record_fields(content)
        )

        self.assert_error(
            errors,
            "Invalid or placeholder value "
            "for Supporting Evidence",
        )

    def test_non_text_document_rejected(self):
        _, errors = (
            extract_review_record_fields(None)
        )

        self.assert_error(
            errors,
            "Technical review document must contain text",
        )

    # Registry and document consistency

    def test_matching_document_content(self):
        home = self.make_home()

        self.assertEqual(
            validate_review_record_content(
                home,
                self.make_document(home),
            ),
            [],
        )

    def test_mismatched_reference_home_id(self):
